# Kalshi Dashboard — environment variables.
# Set the real values in the Vercel project (Settings -> Environment Variables).
# Never commit real secrets. This file documents the slots only.

# Shared site password for the JWT login gate (HANDOFF §5.2/§5.4).
SITE_PASSWORD=

# Random 32-byte hex string — signs the dash_jwt session cookie (HMAC-SHA-256).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Fine-grained GitHub PAT, read-only on the kalshi-dashboard-data repo only.
# Used server-side by api/data/* to fetch via the GitHub Contents API.
# NEVER expose this to client JS.
GITHUB_TOKEN_DASHBOARD_DATA=

# Owner of the private data repo (used to build the Contents API URL).
DASHBOARD_DATA_OWNER=curtisstuck-stack
DASHBOARD_DATA_REPO=kalshi-dashboard-data
