{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "portfolio_snapshot.schema.json",
  "title": "PortfolioSnapshot",
  "description": "Current portfolio state. The pusher writes two files: portfolio/snapshot.paper.json and portfolio/snapshot.live.json, both conforming to this schema.",
  "type": "object",
  "required": ["generated_at", "mode", "cash_usd", "open_positions"],
  "additionalProperties": true,
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["paper", "live", "shadow"] },
    "cash_usd": { "type": "number", "minimum": 0 },
    "exposure_usd": { "type": "number" },
    "unrealized_pnl_usd": { "type": "number" },
    "realized_pnl_today_usd": { "type": "number" },
    "open_positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ticker", "side", "qty", "avg_price"],
        "additionalProperties": true,
        "properties": {
          "ticker": { "type": "string" },
          "side": { "enum": ["yes", "no"] },
          "qty": { "type": "integer" },
          "avg_price": { "type": "number" },
          "current_mid": { "type": "number" },
          "unrealized_pnl_usd": { "type": "number" },
          "opened_at": { "type": "string", "format": "date-time" },
          "exit_plan": { "type": "string" }
        }
      }
    }
  }
}
