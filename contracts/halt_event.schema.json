{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "halt_event.schema.json",
  "title": "HaltEvent",
  "description": "One halt/block event. health/halts.json is a rolling array (last 200) tailed from kalshi-mm/data/executor_halts.jsonl.",
  "type": "object",
  "required": ["event", "reason", "iso_time"],
  "additionalProperties": true,
  "properties": {
    "event": { "type": "string" },
    "status": { "type": "string" },
    "reason": { "type": "string" },
    "ticker": { "type": "string" },
    "severity": { "type": "string" },
    "details": { "type": "object", "additionalProperties": true },
    "iso_time": { "type": "string", "format": "date-time" },
    "ts": { "type": "number" },
    "source": { "type": "string" }
  }
}
