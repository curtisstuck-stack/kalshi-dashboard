{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "signal_accuracy.schema.json",
  "title": "SignalAccuracy",
  "description": "signals/accuracy.json — per-signal rolling accuracy. Copied from kalshi-mm/data/signal_accuracy.json (renamed by the pusher). Keys are signal names.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "accuracy": { "type": "number" },
      "correct_calls": { "type": "integer" },
      "last_outcome": { "type": "number" },
      "last_updated": { "type": "string" },
      "total_calls": { "type": "integer" }
    }
  }
}
